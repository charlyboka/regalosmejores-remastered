# Copy to .env and fill in. .env is gitignored; never commit real values.
APP_ENV=development
LOG_LEVEL=INFO

# --- Django ---
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://localhost:8000
SESSION_SALT=

# --- Database (local dev points at the production Heroku Postgres) ---
DATABASE_URL=postgres://user:password@host:5432/dbname

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_PROJECT=
OPENAI_ORGANIZATION=
OPENAI_DEFAULT_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=512
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=3

# --- Keepa ---
KEEPA_API_KEY=
KEEPA_DOMAIN_ID=9
KEEPA_TOKEN_RESERVE=20
KEEPA_REQUEST_TIMEOUT_SECONDS=30

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# --- Amazon affiliate ---
AMAZON_AFFILIATE_TAG=
AMAZON_MARKETPLACE_HOST=www.amazon.es

# --- Pipelines / budgets ---
PIPELINES_ENABLED=true
LLM_DAILY_BUDGET_USD=5
MAX_HYDRATION_BACKLOG=5000
